{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.example/schemas/workflow/v1.json",
  "title": "Workflow specification v1",
  "description": "Versioned workflow document. The graph is immutable once published; an execution pins one workflow_version_id. Explicit start/end nodes are optional; roots and terminal nodes are derived when they are absent. CEL expressions are compiled at publish time.",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_id",
    "name",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^wf_[A-Za-z0-9_-]{8,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "input_schema": {
      "type": "object",
      "description": "Optional JSON Schema used to validate execution input.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "type": {
          "enum": [
            "start",
            "end",
            "agent",
            "llm",
            "tool",
            "condition",
            "transform",
            "parallel",
            "join",
            "delay",
            "approval",
            "subworkflow",
            "loop"
          ]
        },
        "agent": {
          "$ref": "#/$defs/agentRef"
        },
        "tool": {
          "$ref": "#/$defs/toolRef"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "config": {
          "$ref": "#/$defs/nodeConfig"
        },
        "input_from": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "input_schema": {
          "type": "object",
          "additionalProperties": true
        },
        "output_schema": {
          "type": "object",
          "additionalProperties": true
        },
        "worker_pool": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "retry": {
          "$ref": "#/$defs/retryPolicy"
        },
        "side_effect_class": {
          "enum": [
            "read_only",
            "idempotent",
            "non_idempotent"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "checkpoint_mode": {
          "enum": [
            "none",
            "on_node_end",
            "inherit"
          ]
        },
        "require_checkpoint": {
          "type": "boolean"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "agent"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "agent"
            ],
            "not": {
              "required": [
                "tool"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "llm"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "agent"
            ],
            "not": {
              "required": [
                "tool"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tool"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "tool"
            ],
            "not": {
              "required": [
                "agent"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "condition"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "transform"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "join"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "delay"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "subworkflow"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "loop"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "config"
            ]
          }
        }
      ]
    },
    "agentRef": {
      "type": "object",
      "required": [
        "agent_id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^agt_[A-Za-z0-9_-]{8,64}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "toolRef": {
      "type": "object",
      "required": [
        "tool_id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "tool_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "when": {
          "type": "string",
          "maxLength": 2000,
          "description": "Optional CEL boolean over input, outputs, params, execution, iteration and previous."
        },
        "data_mapping": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "retry_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "transient",
              "timeout",
              "worker_lost",
              "result_invalid",
              "cancelled",
              "any"
            ]
          }
        },
        "backoff_base_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "backoff_max_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_failure": {
          "enum": [
            "fail_fast",
            "continue"
          ]
        },
        "retry": {
          "$ref": "#/$defs/retryPolicy"
        }
      }
    },
    "nodeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "mapping": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "join": {
          "$ref": "#/$defs/joinPolicy"
        },
        "delay": {
          "$ref": "#/$defs/delayConfig"
        },
        "approval": {
          "$ref": "#/$defs/approvalConfig"
        },
        "workflow": {
          "$ref": "#/$defs/subworkflowRef"
        },
        "loop": {
          "$ref": "#/$defs/loopConfig"
        },
        "input": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "output_from": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 50,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        }
      }
    },
    "joinPolicy": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "all",
            "successful"
          ]
        },
        "successful": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "on_partial": {
          "enum": [
            "fail",
            "skip",
            "continue"
          ]
        }
      }
    },
    "delayConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "until": {
          "type": "string",
          "format": "date-time"
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "approvalConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "maxLength": 2000
        },
        "on_reject": {
          "enum": [
            "fail",
            "skip",
            "continue"
          ]
        },
        "approvers": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "policy": {
          "enum": [
            "any",
            "all"
          ]
        },
        "expires_in_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "reject_reason_required": {
          "type": "boolean"
        }
      }
    },
    "subworkflowRef": {
      "type": "object",
      "required": [
        "workflow_id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^wf_[A-Za-z0-9_-]{8,64}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "loopConfig": {
      "type": "object",
      "required": [
        "max_iterations"
      ],
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "exit_when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_cores": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1024
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 16,
          "maximum": 1048576
        }
      }
    }
  }
}
