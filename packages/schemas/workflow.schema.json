{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.example/schemas/workflow/v1.json",
  "title": "Workflow specification v1",
  "description": "Versioned workflow document. The graph is immutable once published; an execution pins one workflow_version_id. Start/end nodes are implicit: root and terminal nodes are derived from edges. CEL `when` compilation is a publish-time check performed by the control plane.",
  "type": "object",
  "required": ["schema_version", "workflow_id", "name", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "workflow_id": {
      "type": "string",
      "pattern": "^wf_[A-Za-z0-9_-]{8,64}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/edge" }
    },
    "policy": { "$ref": "#/$defs/policy" },
    "input_schema": {
      "type": "object",
      "description": "Optional JSON Schema used to validate execution input.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "type": { "enum": ["agent", "tool"] },
        "agent": { "$ref": "#/$defs/agentRef" },
        "tool": { "$ref": "#/$defs/toolRef" },
        "params": { "type": "object", "additionalProperties": true },
        "input_from": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "worker_pool": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "retry": { "$ref": "#/$defs/retryPolicy" },
        "side_effect_class": { "enum": ["read_only", "idempotent", "non_idempotent"] },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 500 },
        "checkpoint_mode": { "enum": ["none", "on_node_end", "inherit"] },
        "require_checkpoint": { "type": "boolean" },
        "output_schema": { "type": "object", "additionalProperties": true }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "agent" } }, "required": ["type"] },
          "then": { "required": ["agent"], "not": { "required": ["tool"] } }
        },
        {
          "if": { "properties": { "type": { "const": "tool" } }, "required": ["type"] },
          "then": { "required": ["tool"], "not": { "required": ["agent"] } }
        }
      ]
    },
    "agentRef": {
      "type": "object",
      "required": ["agent_id", "version"],
      "additionalProperties": false,
      "properties": {
        "agent_id": { "type": "string", "pattern": "^agt_[A-Za-z0-9_-]{8,64}$" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "toolRef": {
      "type": "object",
      "required": ["tool_id", "version"],
      "additionalProperties": false,
      "properties": {
        "tool_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "to": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "when": {
          "type": "string",
          "maxLength": 2000,
          "description": "Optional CEL boolean over `outputs`; omitted means true."
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "retry_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["transient", "timeout", "worker_lost", "result_invalid", "cancelled", "any"] }
        },
        "backoff_base_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "backoff_max_ms": { "type": "integer", "minimum": 100, "maximum": 600000 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_failure": { "enum": ["fail_fast", "continue"] },
        "retry": { "$ref": "#/$defs/retryPolicy" }
      }
    }
  }
}
