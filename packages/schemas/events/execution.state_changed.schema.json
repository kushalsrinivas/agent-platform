{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.example/schemas/events/execution.state_changed/v1.json",
  "title": "execution.state_changed payload v1",
  "type": "object",
  "required": ["seq", "from", "to", "state_version", "counts"],
  "additionalProperties": false,
  "properties": {
    "seq": { "type": "integer", "minimum": 1 },
    "from": { "enum": ["pending", "running", "failing", "cancel_requested", "succeeded", "failed", "cancelled"] },
    "to": { "enum": ["pending", "running", "failing", "cancel_requested", "succeeded", "failed", "cancelled"] },
    "state_version": { "type": "integer", "minimum": 2 },
    "reason": { "type": "string", "maxLength": 500 },
    "failure_code": { "type": "string", "maxLength": 128 },
    "counts": { "$ref": "#/$defs/counts" }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "required": ["total", "pending", "assigned", "running", "succeeded", "failed", "cancelled", "skipped"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "assigned": { "type": "integer", "minimum": 0 },
        "running": { "type": "integer", "minimum": 0 },
        "succeeded": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "cancelled": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
