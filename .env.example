# Local configuration for running services outside Docker (make dev runs inside Docker and needs none of this).
# Copy to .env: make setup does this for you.
#
# Compose also reads this file for the variables it interpolates (POSTGRES_PASSWORD, MINIO_*, API_CORS_ORIGINS).
# Changing POSTGRES_PASSWORD after the volume exists does not change the database password; see docs/deployment.md.

# Infrastructure credentials (development defaults)
POSTGRES_PASSWORD=postgres
# Change if another Postgres already listens on 5432.
POSTGRES_PORT=5432
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Public dashboard origin for the VPS compose override (CORS).
# PUBLIC_DASHBOARD_ORIGIN=https://app.example.com

ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=json

# API
API_HTTP_ADDR=:8080
API_DATABASE_URL=postgres://app_api:dev_api_password@localhost:5432/agent_platform?sslmode=disable
API_CORS_ORIGINS=http://localhost:3000

# Orchestrator
ORCHESTRATOR_GRPC_ADDR=:9090
ORCHESTRATOR_HTTP_ADDR=:8081
ORCHESTRATOR_DATABASE_URL=postgres://app_orchestrator:dev_orchestrator_password@localhost:5432/agent_platform?sslmode=disable
ORCHESTRATOR_NATS_URL=nats://localhost:4222

# Worker (never receives database credentials)
WORKER_ID=worker-local
WORKER_HTTP_ADDR=:8082
WORKER_NATS_URL=nats://localhost:4222
WORKER_ORCHESTRATOR_GRPC_ADDR=localhost:9090
WORKER_POOL=default
WORKER_MAX_CONCURRENCY=4

# Dashboard
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
