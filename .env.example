# Local configuration for running services outside Docker (make dev runs inside Docker and needs none of this).
# Copy to .env: make setup does this for you.
#
# Compose also reads this file for the variables it interpolates (POSTGRES_PASSWORD, MINIO_*, API_CORS_ORIGINS).
# Changing POSTGRES_PASSWORD after the volume exists does not change the database password; see docs/deployment.md.

# Infrastructure credentials (development defaults)
POSTGRES_PASSWORD=postgres
# Host ports. Change any of these if another local project already uses the default.
POSTGRES_PORT=5432
NATS_PORT=4222
NATS_MONITOR_PORT=8222
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Application host ports
API_PORT=8080
ORCHESTRATOR_GRPC_PORT=9090
ORCHESTRATOR_HTTP_PORT=8081
WORKER_PORT=8082
DASHBOARD_PORT=3000

# Public dashboard origin for the VPS compose override (CORS).
# PUBLIC_DASHBOARD_ORIGIN=https://app.example.com

ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=json

# API
API_HTTP_ADDR=:8080
API_DATABASE_URL=postgres://app_api:dev_api_password@localhost:5432/agent_platform?sslmode=disable
API_CORS_ORIGINS=http://localhost:3000
API_ORCHESTRATOR_GRPC_ADDR=localhost:9090
API_ORCHESTRATOR_INSECURE=true
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_BURST=30

# Authentication: OIDC in production; dev token issuance only when ENVIRONMENT=development.
AUTH_MODE=dev
AUTH_DEV_SECRET=dev-only-auth-secret-change-me
AUTH_DEV_ISSUER=agent-platform-dev
AUTH_AUDIENCE=agent-platform-api
# OIDC_ISSUER_URL=https://idp.example.com
# OIDC_CLIENT_ID=agent-platform-api

# Orchestrator
ORCHESTRATOR_GRPC_ADDR=:9090
ORCHESTRATOR_HTTP_ADDR=:8081
ORCHESTRATOR_DATABASE_URL=postgres://app_orchestrator:dev_orchestrator_password@localhost:5432/agent_platform?sslmode=disable
ORCHESTRATOR_NATS_URL=nats://localhost:4222
ORCHESTRATOR_MAX_ACTIVE_EXECUTIONS=20
ORCHESTRATOR_MAX_QUEUED_EXECUTIONS=100
ORCHESTRATOR_MAX_EXECUTION_SECONDS=86400
# Single-node development uses one stream replica; a NATS cluster needs 3.
ORCHESTRATOR_STREAM_REPLICAS=1
# Operator-only messaging status and DLQ redrive are disabled when this is empty.
ORCHESTRATOR_ADMIN_TOKEN=
ORCHESTRATOR_DISPATCH_INTERVAL_MS=500
ORCHESTRATOR_REAPER_INTERVAL_MS=2000
ORCHESTRATOR_OUTBOX_INTERVAL_MS=250
ORCHESTRATOR_OUTBOX_BATCH=50
ORCHESTRATOR_OUTBOX_RETRY_SECONDS=5
ORCHESTRATOR_LEASE_SECONDS=30
ORCHESTRATOR_HEARTBEAT_TIMEOUT_SECONDS=15
ORCHESTRATOR_WORKER_TERMINATE_SECONDS=60
# 0 disables the per-tenant active-task cap.
ORCHESTRATOR_MAX_ACTIVE_TASKS_PER_TENANT=0
# Optional global caps: "echo=1,openai=4" and "tool_web_search=2".
ORCHESTRATOR_PROVIDER_CONCURRENCY=
ORCHESTRATOR_TOOL_CONCURRENCY=

# Worker (never receives database credentials)
WORKER_ID=wrk_worker_local
WORKER_HTTP_ADDR=:8082
WORKER_NATS_URL=nats://localhost:4222
WORKER_ORCHESTRATOR_GRPC_ADDR=localhost:9090
WORKER_ORCHESTRATOR_TLS=false
WORKER_POOL=default
WORKER_RUNTIME=python
WORKER_RUNTIME_VERSION=0.1.0
WORKER_CAPABILITIES=agent_execution,tool_execution
# 0 uses the host CPU count.
WORKER_CPU_CORES=0
WORKER_MEMORY_MB=2048
WORKER_HEARTBEAT_MS=5000
WORKER_SHUTDOWN_GRACE_SECONDS=25
# The Go worker spawns one Python process per attempt over a Unix socket. Empty disables Python and uses the
# offline echo executor (useful for messaging-only smoke runs).
WORKER_RUNTIME_COMMAND=python -m agent_runtime serve --socket {socket}
WORKER_RUNTIME_STARTUP_SECONDS=15
WORKER_RUNTIME_KILL_SECONDS=5
WORKER_MAX_CONCURRENCY=4

# Dashboard
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
